{
  "name": "sykero-smart-alarm",
  "author": "Sykerö Software",
  "version": "1.4.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Sykerö Smart Alarm",
    "uuid": "cba6bb36-e731-46b3-b5c7-915a997b8c61",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "capabilities": [
      "health"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "AlarmSet",
      "SmartEnabled",
      "SmartWindowMin",
      "TimeSemantics",
      "Sensitivity",
      "SensPercentile",
      "SensMinutes",
      "WakeProfile",
      "EscLeadGapS",
      "EscMinGapS",
      "EscTightenS",
      "EscVibStartMs",
      "EscVibMaxMs",
      "EscPulsesStart",
      "EscPulsesMax",
      "EscSoundAfterS",
      "EscSoundRampS",
      "EscVolStart",
      "EscVolMax",
      "EscCapS",
      "SnoozeMin",
      "SnoozeMax",
      "SnoozeRampOffsetS",
      "CfgRequest",
      "EscRampVib",
      "DebugFeatures",
      "PreAlarmMin"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "menuIcon": true,
          "name": "MENU_ICON",
          "file": "images/menuicon.png"
        }
      ]
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "node --test tests/*.test.js && npm run test:c",
    "test:c": "bash tests/run_c_tests.sh"
  }
}
